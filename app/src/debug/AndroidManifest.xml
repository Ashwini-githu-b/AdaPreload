<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only overlay: the E2b prewarm-lab screen. Never merged into a release build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Separate launcher icon in debug builds so the researcher can open the lab directly;
             also launchable with: adb shell am start -n com.adapreload.instrumentation/.prewarm.PrewarmLabActivity -->
        <activity
            android:name="com.adapreload.instrumentation.prewarm.PrewarmLabActivity"
            android:exported="true"
            android:label="AdaPreload Prewarm Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Debug-only memory-pressure generator for the E2b robustness experiment. Runs in a
             separate ":stress" process so releasing it never disturbs the main process that holds
             the Brave binding. Start it with "am start" (int extra "mb"); release it with
             "am broadcast" of PREWARM_MEM_RELEASE. See MemPressureActivity for the exact commands. -->
        <activity
            android:name="com.adapreload.instrumentation.prewarm.MemPressureActivity"
            android:exported="true"
            android:process=":stress"
            android:excludeFromRecents="true"
            android:label="AdaPreload Mem Pressure" />

        <!-- Debug-only adb trigger so bind/unbind can be scripted with an exact, repeatable delay.
             Target it explicitly (am broadcast -n .../.prewarm.PrewarmLabReceiver). Brave-only. -->
        <receiver
            android:name="com.adapreload.instrumentation.prewarm.PrewarmLabReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.adapreload.instrumentation.PREWARM_BIND" />
                <action android:name="com.adapreload.instrumentation.PREWARM_UNBIND" />
            </intent-filter>
        </receiver>

        <!-- Debug-only adb trigger that exports the on-device dry-run evaluation (the recorded
             layer2_log + shadow_decisions joined to the canonical sequence). Strictly read-only:
             no model run, no Layer 2 update, no binding. Target it explicitly
             (am broadcast -n .../.eval.DryRunReceiver). -->
        <receiver
            android:name="com.adapreload.instrumentation.eval.DryRunReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.adapreload.instrumentation.DRYRUN_EXPORT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
